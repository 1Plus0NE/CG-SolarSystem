<world>
    <window width="1280" height="720" />
    <camera>
        <position x="0" y="200" z="400" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="45" near="1" far="2000" />
    </camera>

    <!-- SUN (at origin) — rotation period 2.54s (direct) -->
    <group>
        <transform>
            <rotate time="2.54" x="0" y="1" z="0" />
            <scale x="21.84" y="21.84" z="21.84" />
        </transform>
        <models>
            <model file="icosphere.3d" color="#FDB813" />
        </models>
    </group>

    <!-- MERCURY — orbit period 8.8s; rotation period 5.87s (direct) -->
