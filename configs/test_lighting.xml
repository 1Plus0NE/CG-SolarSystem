<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lighting showcase scene — testa os 3 tipos de luzes com materiais contrastantes:
    - Luz pontual quente no centro (sol artificial)
    - Luz direcional fria azulada (luz de preenchimento)
    - Spotlight vermelho/laranja lateral (luz dramática)

  Materiais representados:
    1. Emissivo (sol central) — não depende de luz externa
    2. Metálico prateado (icosfera) — shininess alto, specular forte
    3. Ouro (torus) — difuso quente, specular amarelado
    4. Plástico mate (caixa) — shininess baixo, pouco specular
    5. Borracha (cone) — sem brilho, apenas difuso
    6. Cerâmica (cilindro) — shininess médio, textura brick
    7. Plano de chão com textura grass
-->
<world>
    <window width="1280" height="800" />

    <camera>
        <position x="18" y="22" z="22" />
        <lookAt x="0" y="2" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="55" near="0.5" far="500" />
    </camera>

    <!-- Luz ambiente global muito baixa para realçar o contraste das luzes -->
    <globalAmbient r="0.05" g="0.05" b="0.08" a="1.0" />

    <lights>
        <!-- Luz pontual quente no topo (simula lâmpada incandescente) -->
        <light type="point"
               posX="0" posY="12" posZ="0"
               r="255" g="220" b="160" intensity="1.0" />

        <!-- Luz direcional fria — fill light vinda da esquerda/cima -->
        <light type="directional"
               dirX="1" dirY="-0.8" dirZ="0.5"
               r="140" g="170" b="255" intensity="0.4" />

        <!-- Spotlight laranja lateral — destaca objetos da direita -->
        <light type="spot"
               posX="16" posY="10" posZ="6"
               dirX="-1" dirY="-0.6" dirZ="-0.3"
               cutoff="25"
               r="255" g="130" b="40" intensity="1.2" />
    </lights>

    <!-- ===== PLANO DE CHÃO ===== -->
    <group>
        <transform>
            <scale x="8" y="1" z="8" />
        </transform>
        <models>
            <model file="tex_plane.obj">
                <texture file="textures/relva.jpg" />
                <color>
                    <diffuse  R="180" G="180" B="180" />
                    <ambient  R="30"  G="30"  B="30"  />
                    <specular R="40"  G="40"  B="40"  />
                    <emissive R="0"   G="0"   B="0"   />
                    <shininess value="8" />
                </color>
            </model>
        </models>
    </group>

    <!-- ===== CENTRO: esfera emissiva (fonte de luz visual) ===== -->
    <group>
        <transform>
            <translate x="0" y="3" z="0" />
            <scale x="1.2" y="1.2" z="1.2" />
        </transform>
        <models>
            <model file="tex_sphere.obj">
                <texture file="textures/2k_sun.jpg" />
                <color>
                    <diffuse  R="255" G="220" B="80"  />
                    <ambient  R="255" G="220" B="80"  />
                    <specular R="0"   G="0"   B="0"   />
                    <emissive R="255" G="200" B="60"  />
                    <shininess value="0" />
                </color>
            </model>
        </models>
    </group>

    <!-- ===== FRENTE: icosfera metálica prateada ===== -->
    <!-- Shininess muito alto: reflexo especular pequeno e muito brilhante -->
    <group>
        <transform>
            <translate x="6" y="1.5" z="6" />
            <scale x="1.5" y="1.5" z="1.5" />
        </transform>
        <models>
            <model file="tex_icosphere.obj">
                <color>
                    <diffuse  R="190" G="190" B="200" />
                    <ambient  R="30"  G="30"  B="35"  />
                    <specular R="255" G="255" B="255" />
                    <emissive R="0"   G="0"   B="0"   />
                    <shininess value="128" />
                </color>
            </model>
        </models>
    </group>

    <!-- ===== ESQUERDA: torus dourado ===== -->
    <!-- Shininess médio-alto: reflete de forma mais suave que o metal -->
    <group>
        <transform>
            <translate x="-7" y="1.8" z="2" />
            <rotate angle="60" x="1" y="0" z="0" />
            <scale x="1.6" y="1.6" z="1.6" />
        </transform>
        <models>
            <model file="tex_torus.obj">
                <color>
                    <diffuse  R="212" G="175" B="55"  />
                    <ambient  R="40"  G="33"  B="10"  />
                    <specular R="255" G="240" B="160" />
                    <emissive R="0"   G="0"   B="0"   />
                    <shininess value="64" />
                </color>
            </model>
        </models>
    </group>

    <!-- ===== DIREITA: caixa plástica verde-mate ===== -->
    <!-- Shininess baixo: reflexo especular largo e fraco -->
    <group>
        <transform>
            <translate x="7" y="1.5" z="-4" />
            <rotate angle="30" x="0" y="1" z="0" />
            <scale x="2.5" y="2.5" z="2.5" />
        </transform>
        <models>
            <model file="tex_box.obj">
                <color>
                    <diffuse  R="60"  G="160" B="80"  />
                    <ambient  R="10"  G="30"  B="15"  />
                    <specular R="70"  G="90"  B="75"  />
                    <emissive R="0"   G="0"   B="0"   />
                    <shininess value="12" />
                </color>
            </model>
        </models>
    </group>

    <!-- ===== FUNDO-ESQUERDA: cone borracha vermelha ===== -->
    <!-- Sem brilho — totalmente difuso -->
    <group>
        <transform>
            <translate x="-5" y="0" z="-6" />
            <scale x="2" y="2" z="2" />
        </transform>
        <models>
            <model file="tex_cone.obj">
                <color>
                    <diffuse  R="200" G="40"  B="30"  />
                    <ambient  R="40"  G="8"   B="6"   />
                    <specular R="20"  G="10"  B="10"  />
                    <emissive R="0"   G="0"   B="0"   />
                    <shininess value="2" />
                </color>
            </model>
        </models>
    </group>

    <!-- ===== FUNDO-DIREITA: cilindro cerâmica com textura tijolo ===== -->
    <!-- Shininess médio: cerâmica vidrada -->
    <group>
        <transform>
            <translate x="2" y="0" z="-8" />
            <scale x="1.8" y="2.5" z="1.8" />
        </transform>
        <models>
            <model file="tex_cylinder.obj">
                <texture file="textures/red_brick_diff_4k.jpg" />
                <color>
                    <diffuse  R="200" G="160" B="130" />
                    <ambient  R="35"  G="28"  B="22"  />
                    <specular R="160" G="130" B="110" />
                    <emissive R="0"   G="0"   B="0"   />
                    <shininess value="32" />
                </color>
            </model>
        </models>
    </group>

    <!-- ===== FUNDO-CENTRO: esfera espelhada azul ===== -->
    <!-- Shininess máximo: quase espelho -->
    <group>
        <transform>
            <translate x="-1" y="2" z="-10" />
            <scale x="2" y="2" z="2" />
        </transform>
        <models>
            <model file="tex_sphere.obj">
                <color>
                    <diffuse  R="50"  G="100" B="200" />
                    <ambient  R="8"   G="15"  B="35"  />
                    <specular R="220" G="230" B="255" />
                    <emissive R="0"   G="0"   B="0"   />
                    <shininess value="200" />
                </color>
            </model>
        </models>
    </group>

</world>
