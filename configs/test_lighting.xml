<?xml version="1.0" encoding="UTF-8"?>
<world>
    <window width="1200" height="800" />
    
    <camera>
        <position x="20" y="20" z="20" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="1000" />
    </camera>

    <!-- Light sources -->
    <lights>
        <!-- Point light above the scene -->
        <light type="point" posX="10" posY="15" posZ="10" 
                r="255" g="255" b="200" intensity="1.5" />
        
        <!-- Directional light from top-left -->
        <light type="directional" dirX="1" dirY="-1" dirZ="0.5"
                r="200" g="200" b="255" intensity="0.8" />
        
        <!-- Spotlight from front-top -->
        <light type="spot" posX="0" posY="25" posZ="20"
                dirX="0" dirY="-1" dirZ="-0.5" cutoff="30"
                r="255" g="200" b="200" intensity="1.2" />
    </lights>

    <!-- Scene content -->
    <group>
        <transform>
            <translate x="0" y="0" z="0" />
            <scale x="1" y="1" z="1" />
        </transform>
        
        <models>
            <!-- Red sphere with phong material -->
            <model file="sphere.obj" cull="true">
                <texture file="textures/earth.jpg" />
                <color>
                    <diffuse R="200" G="50" B="50" />
                    <ambient R="50" G="10" B="10" />
                    <specular R="255" G="255" B="255" />
                    <emissive R="0" G="0" B="0" />
                    <shininess value="32" />
                </color>
            </model>
        </models>

        <!-- Rotating sphere -->
        <group>
            <transform>
                <translate x="0" y="0" z="8" />
                <rotate x="0" y="1" z="0" angle="45" />
                <scale x="0.5" y="0.5" z="0.5" />
            </transform>
            <models>
                <model file="sphere_small.obj" cull="true">
                    <color>
                        <diffuse R="50" G="150" B="255" />
                        <ambient R="10" G="30" B="50" />
                        <specular R="200" G="200" B="200" />
                        <emissive R="0" G="0" B="0" />
                        <shininess value="64" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Cube at side -->
        <group>
            <transform>
                <translate x="10" y="0" z="0" />
                <scale x="2" y="2" z="2" />
            </transform>
            <models>
                <model file="box.obj" cull="true">
                    <color>
                        <diffuse R="150" G="200" B="50" />
                        <ambient R="30" G="40" B="10" />
                        <specular R="150" G="150" B="100" />
                        <emissive R="0" G="0" B="0" />
                        <shininess value="16" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Torus at other side -->
        <group>
            <transform>
                <translate x="-10" y="3" z="0" />
                <rotate x="1" y="0" z="0" angle="45" />
                <scale x="1.5" y="1.5" z="1.5" />
            </transform>
            <models>
                <model file="torus.obj" cull="true">
                    <color>
                        <diffuse R="200" G="150" B="50" />
                        <ambient R="40" G="30" B="10" />
                        <specular R="255" G="255" B="200" />
                        <emissive R="0" G="0" B="0" />
                        <shininess value="48" />
                    </color>
                </model>
            </models>
        </group>
    </group>
</world>
