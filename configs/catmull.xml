<world>
    <window width="800" height="600" />
    <camera>
        <position x="0" y="10" z="20" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="1000" />
    </camera>

    <!-- objeto que percorre a curva sem alinhar -->
    <group>
        <transform>
            <translate time="5" align="False">
                <point x="3"  y="0" z="0"  />
                <point x="0"  y="0" z="3"  />
                <point x="-3" y="0" z="0"  />
                <point x="0"  y="0" z="-3" />
                <point x="3"  y="0" z="0"  />
                <point x="0"  y="0" z="3"  />
            </translate>
        </transform>
        <models>
            <model file="icosphere.3d" color="#FF0000" />
        </models>
    </group>
</world>